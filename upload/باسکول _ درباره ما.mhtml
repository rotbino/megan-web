Content-Transfer-Encoding: quoted-printable
Content-Location: https://www.buskool.com/css/app.css?id=80913bbaa6500fec6dbc

@charset "utf-8";

#app, #app > div, body, html { height: 100%; }

* { scrollbar-width: thin; }

::-webkit-scrollbar { width: 5px; }

body { overflow-y: scroll; }

a, a:active, a:focus, a:hover, a:visited { outline: none; }

input, textarea { appearance: none; }

input:-webkit-autofill, input:-webkit-autofill:active, input:-webkit-autofi=
ll:focus, input:-webkit-autofill:hover { box-shadow: rgb(251, 251, 251) 0px=
 0px 0px 30px inset !important; }

.hover-effect, .hover-effect:hover { transition: 0.2s !important; }

.hover-effect:hover { box-shadow: rgba(0, 0, 0, 0.2) 0px 3px 8px inset !imp=
ortant; }

.noselect { user-select: none; }

.standard-line { line-height: 1.618; }

.default-user-contents { border-bottom: 2px solid rgb(238, 238, 238); }

.modal-opened { overflow: hidden; }

.content-full-width { height: 20px; width: 100%; }

.content-full-width, .content-half-width { display: block; overflow: hidden=
; border-radius: 3px; }

.content-half-width { height: 15px; width: 50%; }

.content-default-width { width: 75%; }

.content-default-width, .content-min-width { height: 15px; display: block; =
overflow: hidden; border-radius: 3px; }

.content-min-width { width: 25%; }

.full-content-wrapp { position: absolute; width: 100%; height: 100%; }

.default-main-article-content { width: calc(100% - 140px); padding: 0px 10p=
x; }

.default-main-article-content span { margin: 0px 0px 13px auto; }

.default-main-image { position: relative; padding: 100%; }

.default-wrapper-main-image { position: relative; width: 120px; height: 120=
px; overflow: hidden; border-radius: 4px; }

.default-finish-step-image { height: 130px; }

