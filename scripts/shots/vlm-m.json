        "content": "```html\n<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>پنل فروشنده</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;900&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Vazirmatn', sans-serif;\n            background-color: #f3f4f6;\n        }\n        /* Hide scrollbar for clean mobile look */\n        ::-webkit-scrollbar {\n            width: 0px;\n            background: transparent;\n        }\n    </style>\n</head>\n<body class=\"text-gray-800 pb-24\">\n\n    <!-- Main Container (Mobile Width) -->\n    <div class=\"max-w-[390px] mx-auto bg-gray-50 min-h-screen relative shadow-xl overflow-hidden\">\n\n        <!-- Header -->\n        <header class=\"bg-white px-4 py-4 flex justify-between items-center sticky top-0 z-20 border-b border-gray-100\">\n            <button class=\"p-2 -ml-2 text-gray-600 hover:bg-gray-100 rounded-lg transition\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg>\n            </button>\n            \n            <div class=\"flex items-center gap-2 cursor-pointer\">\n                <span class=\"text-sm font-bold text-gray-700\">گالری</span>\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6b7280\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"></circle><polyline points=\"21 15 16 10 5 21\"></polyline></svg>\n            </div>\n        </header>\n\n        <!-- Content Scrollable Area -->\n        <main class=\"px-4 py-5 space-y-4 overflow-y-auto h-[calc(100vh-80px)]\">\n\n            <!-- Profile Card -->\n            <section class=\"bg-white rounded-2xl p-5 shadow-sm relative\">\n                <!-- Edit Button Absolute -->\n                <button class=\"absolute top-5 right-5 flex items-center gap-1 bg-white border border-gray-300 text-xs font-medium py-1.5 px-3 rounded-md text-gray-600 hover:bg-gray-50 transition\">\n                    <span>ویرایش پروفایل</span>\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path><path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path></svg>\n                </button>\n\n                <!-- User Info -->\n                <div class=\"flex justify-between items-start mt-10 mb-6\">\n                    <div class=\"flex flex-col\">\n                        <span class=\"font-bold text-lg text-gray-800\">سالم حیدری</span>\n                        <span class=\"text-xs text-gray-500 mt-1\">فروشنده - تهران</span>\n                    </div>\n                    \n                    <div class=\"w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 font-bold text-xl overflow-hidden border-2 border-white shadow-sm\">\n                        س\n                    </div>\n                </div>\n\n                <!-- Status Section -->\n                <div class=\"mb-2\">\n                    <div class=\"flex justify-between items-center mb-2\">\n                        <span class=\"text-sm font-bold text-gray-800\">وضعیت فروشگاه:</