# ═════════════════════════════════════════════════════════════════════════════
# آدرس بک‌اند — خودکار، دیگر نیازی به دست‌کاری این فایل نیست (خواستهٔ مالک ۱۶-۱۱)
# ۱۸-۱۱: بک ابری به اکانت جدید ورسل منتقل شد → https://imach-back.vercel.app
#   • روی ورسل: همیشه و بدون استثنا به بک ابری
#     https://imach-back.vercel.app وصل می‌شود (تشخیص خودکار از محیط —
#     منطق واحد در src/lib/backend-url.ts؛ مستقل از این فایل).
#   • روی لوکال‌هاست: پیش‌فرض بک لوکالِ در حال اجرای خودتان است
#     (http://127.0.0.1:4000 — همان `bun run start` در megan-back).
#   • تغییر دستی «فقط لوکال»: خط زیر را از کامنت دربیاورید و next dev را
#     ری‌استارت کنید (مثلاً برای اتصال موقت به دیتای ابری از لوکال)؛
#     برای برگشت به بک لوکال دوباره کامنتش کنید. این متغیر همه‌جا را می‌برد:
#     پروکسی /api، fetchهای SSR، پنل ایمپورتر ادمین و وب‌سوکت چت.
# BACKEND_URL=https://imach-back.vercel.app

# آدرس عمومی سایت برای canonical/sitemap/SEO — دامنهٔ نهایی
NEXT_PUBLIC_SITE_URL=https://imach.ir

# فقط برای روت‌های مردهٔ پیش‌نمایش سندباکس (/api/conversations) — روی ورسل بی‌استفاده
DATABASE_URL=file:/home/z/my-project/db/custom.db
