# ═════════════════════════════════════════════════════════════════════════════
# سوییچ بک‌اند — «فقط یکی از دو خط زیر» فعال باشد:
#   برای عوض‌کردن، خط فعال را کامنت کنید و خط دیگر را از کامنت دربیاورید؛
#   در لوکال فقط next dev را ری‌استارت کنید، برای ورسل کامیت+پوش (بیلد خودکار).
# این یک متغیر همه‌جا را می‌برد: پروکسی /api (rewrites)، fetchهای SSR،
# پنل ایمپورتر ادمین و وب‌سوکت چت — همه از همین BACKEND_URL مشتق می‌شوند
# (نگاه کنید به next.config.ts بخش env).
# ═════════════════════════════════════════════════════════════════════════════
BACKEND_URL=https://megan-back.vercel.app
# BACKEND_URL=http://localhost:4000

# آدرس عمومی سایت برای canonical/sitemap/SEO — با دامنهٔ نهایی عوض کنید
NEXT_PUBLIC_SITE_URL=https://megan-web1.vercel.app

# فقط برای روت‌های مردهٔ پیش‌نمایش سندباکس (/api/conversations) — روی ورسل بی‌استفاده
DATABASE_URL=file:/home/z/my-project/db/custom.db
