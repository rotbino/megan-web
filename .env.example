# ─────────────────────────────────────────────────────────────────────────────
# نمونهٔ تنظیمات محیط فرانت (ایمچ/megan-web) — این فایل را به .env کپی کنید.
# ═══ سوییچ بک‌اند: در .env فقط خط BACKEND_URL را جابه‌جا کنید ═══
# ═══════════════════════════════──────────────────────────────────────────────

# ── آدرس بک‌اند (تنها کلید سوییچ — همه‌چیز از همین مشتق می‌شود) ──
# پروکسی /api (rewrites)، fetchهای SSR، پنل ایمپورتر ادمین
# (NEXT_PUBLIC_API_URL) و وب‌سوکت چت (NEXT_PUBLIC_WS_URL) همگی از همین
# متغیر در next.config.ts مشتق می‌شوند — متغیر جداگانه لازم نیست.
# ورسل: BACKEND_URL=https://megan-back.vercel.app
# لوکال: BACKEND_URL=http://localhost:4000
BACKEND_URL=http://127.0.0.1:4000

# ── آدرس سایت (canonical/sitemap/SEO) ──
# لوکال: http://localhost:3000 | ورسل: https://megan-web1.vercel.app
# با دامنهٔ نهایی (مثلاً https://imach.ir) عوض کنید.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── میزبان‌های اضافهٔ تصاویر برای next/image (اختیاری) ──
# فقط hostname، جدا با کاما. بک‌اندِ فعال (از BACKEND_URL) و باکت‌های آروان
# به‌صورت پیش‌فرض مجازند؛ اگر CDN/دامنهٔ جدیدی اضافه شد این‌جا معرفی کنید.
# NEXT_IMAGE_HOSTS=img.example.com,cdn.example.net

# ── یادآوری ──
# • NEXT_PUBLIC_API_URL و NEXT_PUBLIC_WS_URL دیگر در .env لازم نیستند —
#   خودکار از BACKEND_URL ساخته می‌شوند (next.config.ts → env).
# • سوییچ لوکال/ابر در بک‌اند هم مجزا است (megan-back/.env → APP_PROFILE).
