# ─────────────────────────────────────────────────────────────────────────────
# نمونهٔ تنظیمات محیط فرانت (ایمچ/megan-web) — این فایل را به .env کپی کنید.
# .env واقعی هرگز کامیت نشود (شامل کلید است).
# ─────────────────────────────────────────────────────────────────────────────

# ── آدرس بک‌اند (کلید اصلی — هم برای پروکسی /api و هم fetchهای SSR) ──
# لوکال/توسعه: پیش‌فرض کافی است. استقرار ابری: آدرس سرور پروداکشن.
# (BACKEND_ORIGIN کلید قدیمی است و هنوز پشتیبانی می‌شود؛ BACKEND_URL اولویت دارد)
BACKEND_URL=http://127.0.0.1:4000

# ── آدرس سایت (canonical/sitemap/SEO) ──
# لوکال: http://localhost:3000 | پروداکشن: https://imach.ir
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── آدرس وب‌سوکت چت (socket.io روی بک‌اند) ──
# در لوکال پیش‌فرض کافی است؛ در پروداکشن دامنهٔ wss واقعی را بگذارید.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── میزبان‌های اضافهٔ تصاویر برای next/image (اختیاری) ──
# فقط hostname، جدا با کاما. بک‌اند لوکال (localhost:4000/uploads) و باکت‌های
# آروان به‌صورت پیش‌فرض مجازند؛ اگر CDN/دامنهٔ جدیدی اضافه شد این‌جا معرفی کنید.
# NEXT_IMAGE_HOSTS=img.example.com,cdn.example.net

# ── یادآوری پروفایل بک‌اند ──
# سوییچ لوکال/ابر در بک‌اند است (megan-back/.env → APP_PROFILE=local|cloud).
# فرانت به‌جز BACKEND_URL نیازی به تغییر ندارد — تصاویر لوکال خودکار از
# localhost:4000/uploads لود می‌شوند.
